{
  "name": "Customizable navigation bar",
  "description": "Choose a list of links or JavaScript snippets to be displayed in the navigation bar.",
  "info": [
    {
      "type": "warning",
      "text": "Only paste JavaScript snippets from people you trust. You may be compromised if you paste malicious JavaScript here. This does not apply to regular links.",
      "id": "javascript"
    }
  ],
  "userscripts": [
    {
      "url": "userscript.js",
      "matches": ["https://scratch.mit.edu/*"],
      "runAtComplete": false
    }
  ],
  "settings": [
    {
      "name": "Items",
      "id": "items",
      "type": "table",
      "default": [
        { "name": "Create", "url": "/projects/editor/" },
        { "name": "Explore", "url": "/explore/projects/all" },
        { "name": "Ideas", "url": "/ideas" },
        { "name": "About", "url": "/about" }
      ],
      "row": [
        {
          "name": "Name",
          "id": "name",
          "type": "string",
          "default": ""
        },
        {
          "name": "URL",
          "id": "url",
          "type": "untranslated",
          "default": ""
        }
      ],
      "presets": [
        {
          "name": "Create",
          "values": { "name": "Create", "url": "/projects/editor/" }
        },
        {
          "name": "Explore",
          "values": { "name": "Explore", "url": "/explore/projects/all" }
        },
        {
          "name": "Ideas",
          "values": { "name": "Ideas", "url": "/ideas" }
        },
        {
          "name": "About",
          "values": { "name": "About", "url": "/about" }
        },
        {
          "name": "Discuss",
          "values": { "name": "Discuss", "url": "/discuss" }
        },
        {
          "name": "Wiki",
          "values": { "name": "Wiki", "url": "https://scratch-wiki.info/" }
        }
      ]
    }
  ],
  "versionAdded": "1.0.0",
  "latestUpdate": {
    "version": "1.24.0",
    "newSettings": ["items"],
    "isMajor": true
  },
  "tags": ["community", "featured"],
  "enabledByDefault": false
}
