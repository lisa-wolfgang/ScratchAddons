{
  "name": "Display stage on left side",
  "description": "Moves the stage to the left side of the editor.",
  "credits": [
    {
      "name": "NitroCipher/ZenithRogue"
    },
    {
      "name": "djdolphin"
    },
    {
      "name": "World_Languages",
      "note": "full screen button on left",
      "id": "fullscreen"
    }
  ],
  "userscripts": [
    {
      "url": "fix-share-the-love.js",
      "matches": ["projects"]
    }
  ],
  "dynamicEnable": true,
  "dynamicDisable": true,
  "injectAsStyleElt": true,
  "updateUserstylesOnSettingsChange": true,
  "userstyles": [
    {
      "url": "stageleft.css",
      "matches": ["https://scratch.mit.edu/projects/*"]
    },
    {
      "url": "fullscreen-on-left.css",
      "matches": ["https://scratch.mit.edu/projects/*"],
      "if": {
        "fullscreenOnLeft": true
      }
    }
  ],
  "settings": [
    {
      "name": "Full screen button on left",
      "id": "fullscreenOnLeft",
      "type": "boolean",
      "default": false
    }
  ],
  "tags": ["editor", "theme", "featured"],
  "versionAdded": "1.1.0",
  "latestUpdate": {
    "version": "1.25.0",
    "newSettings": ["fullscreenOnLeft"]
  },
  "enabledByDefault": false
}
